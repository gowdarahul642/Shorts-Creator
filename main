#   MAIN
# ==================================================

def main():
    print("="*58)
    print(f"  Owl Learner v10 — {datetime.now().strftime('%Y-%m-%d %H:%M')}")
    print("  7 segments: Hook+Intro+Word+Trans+Example+Tagline+Comment")
    print("="*58)

    if not get_ffmpeg():
        print("ERROR: ffmpeg.exe not found."); sys.exit(1)
    if not GROQ_API_KEY:
        print("ERROR: Set GROQ_API_KEY at top of script."); sys.exit(1)

    script_dir = os.path.dirname(os.path.abspath(__file__))
    ffmpeg     = get_ffmpeg()
    work_dir   = tempfile.mkdtemp(prefix="owl_v10_")

    try:
        print("[0/5] Setting up fonts + tagline...")
        fonts        = get_fonts(script_dir)
        tagline_path = ensure_tagline(script_dir, ffmpeg)

        data   = generate_word_data()
        images = download_images(data["image_prompts"], work_dir)

        for i,img in enumerate(images):
            if not img or not os.path.exists(img):
                fb=os.path.join(work_dir,f"img_{i+1}.jpg")
                try:
                    r=requests.get(
                        f"https://picsum.photos/1080/1920?random={i+600}",
                        timeout=30)
                    with open(fb,"wb") as f: f.write(r.content)
                    images[i]=fb
                except: pass

        audio      = generate_audio(data, work_dir, ffmpeg)
        video_path = render_video(data, images, audio, tagline_path,
                                  work_dir, CHANNEL_LOGO, BG_MUSIC, fonts)
        upload_to_youtube(data, video_path)
        save_used_word(data["german_word"])

        print()
        print("="*58)
        print(f"  DONE! '{data['german_word']}' scheduled!")
        print(f"  Comment prompt: {data.get('comment_prompt_display','')}")
        print("="*58)

    except Exception as e:
        print(f"\n  ERROR: {e}")
        import traceback; traceback.print_exc()
    finally:
        shutil.rmtree(work_dir, ignore_errors=True)
        print("  Temp files cleaned up.")

if __name__=="__main__":
    main()
