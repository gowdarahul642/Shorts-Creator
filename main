# ==================================================
#   CONFIGURATION
# ==================================================
GROQ_API_KEY         = ""   # console.groq.com
CHANNEL_LOGO         = ""
BG_MUSIC             = ""
USED_WORDS_FILE      = "used_words.txt"
YOUTUBE_CREDS        = "youtube_token.pickle"
YOUTUBE_SECRETS      = ""
SCHEDULE_HOURS_AHEAD = 1
GERMAN_VOICE_EDGE    = "de-DE-ConradNeural"
ENGLISH_VOICE_EDGE   = "en-US-GuyNeural"
DIFFICULTY_LEVEL     = "beginner"
TAGLINE_TEXT         = "Bleib neugierig. Owl Learner."
TAGLINE_FILE         = "tagline_audio.wav"
VW, VH               = 1080, 1920
VOICE_WEIGHT         = 1.0
MUSIC_WEIGHT         = 0.10
XFADE_DURATION       = 0.4
HOOK_DURATION        = 2.5
CARD_PAD_Y           = 28
GOLD  = "FFD700"
TEAL  = "00C9A7"
CORAL = "FF6B6B"
PURP  = "C77DFF"
DARK  = "080818"
NAVY  = "0d0d24"

# ==================================================
#   FFMPEG HELPERS
# ==================================================

def get_ffmpeg():
    local = os.path.join(os.path.dirname(os.path.abspath(__file__)), "ffmpeg.exe")
    if os.path.exists(local): return local
    if shutil.which("ffmpeg"): return "ffmpeg"
    return None

def run_ff(cmd, raise_on_error=True):
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0:
        print(f"\nFFmpeg ERROR:\n{r.stderr[-3000:]}")
        if raise_on_error:
            raise subprocess.CalledProcessError(r.returncode, cmd)
    return r

def get_dur(ffmpeg, path):
    r = subprocess.run([ffmpeg, "-i", path], capture_output=True, text=True)
    for line in r.stderr.split("\n"):
        if "Duration" in line:
            try:
                d = line.split("Duration:")[1].split(",")[0].strip()
                h, m, s = d.split(":")
                return float(h)*3600 + float(m)*60 + float(s)
            except: pass
    return 3.0

def safe(text, maxlen=48):
    """Strip unsafe chars for FFmpeg drawtext. Keeps German umlauts."""
    text = re.sub(r'[^\w\s\u00C0-\u024F\-\.]', ' ', text)
    for ch in ["'", '"', ":", "[", "]", "%", ";", ",", "\\", "(", ")", "/"]:
        text = text.replace(ch, " ")
    text = re.sub(r'\s+', ' ', text).strip()
    return text[:maxlen]

def fade(t=0.3):
    return f"if(lt(t,{float(t)}),t/{float(t)},1)"

def ffont(path):
    """Font path safe for FFmpeg filtergraph on Windows."""
    p = path.replace("\\", "/")
    if len(p) > 1 and p[1] == ":":
        p = p[0] + "\\:" + p[2:]
    return p

def resample_wav(ffmpeg, in_path, out_path):
    """Force consistent 44100Hz stereo WAV — fixes sync drift."""
    run_ff([ffmpeg, "-y", "-i", in_path,
            "-ar", "44100", "-ac", "2", "-sample_fmt", "s16", out_path],
           raise_on_error=False)
    if os.path.exists(out_path) and os.path.getsize(out_path) > 1000:
        return out_path
    return in_path

# ==================================================
#   VOICE GENERATION
# ==================================================

def tts_pyttsx3_wav(text, out_wav):
    if not text.strip(): return False
    try:
        import pyttsx3, threading
        success = [False]
        def _run():
            try:
                engine = pyttsx3.init()
                for v in engine.getProperty('voices'):
                    if any(k in (v.name+v.id).lower() for k in
                           ["english","en-us","david","zira","mark","hazel"]):
                        engine.setProperty('voice', v.id); break
                engine.setProperty('rate', 150)
                engine.setProperty('volume', 0.95)
                engine.save_to_file(text, out_wav)
                engine.runAndWait(); engine.stop()
                success[0] = True
            except Exception as e:
                print(f"        pyttsx3: {e}")
        t = threading.Thread(target=_run, daemon=True)
        t.start(); t.join(timeout=15)
        if t.is_alive(): return False
        return os.path.exists(out_wav) and os.path.getsize(out_wav) > 4096
    except: return False

def tts_edge_wav(text, voice, out_wav):
    if not text.strip(): return False
    ffmpeg = get_ffmpeg()
    tmp = out_wav.replace(".wav", "_e.mp3")
    try:
        import asyncio, edge_tts
        async def _run():
            await edge_tts.Communicate(text=text, voice=voice).save(tmp)
        loop = asyncio.new_event_loop(); asyncio.set_event_loop(loop)
        try: loop.run_until_complete(_run())
        finally: loop.close(); asyncio.set_event_loop(None)
        if not os.path.exists(tmp) or os.path.getsize(tmp) < 3000: return False
        run_ff([ffmpeg,"-y","-i",tmp,"-ar","44100","-ac","2","-sample_fmt","s16",out_wav],
               raise_on_error=False)
        return os.path.exists(out_wav) and os.path.getsize(out_wav) > 4096
    except Exception as e:
        print(f"        Edge TTS: {e}"); return False
    finally:
        try:
            if os.path.exists(tmp): os.remove(tmp)
        except: pass

def tts_gtts_wav(text, lang, out_wav):
    if not text.strip(): return False
    ffmpeg = get_ffmpeg()
    tmp = out_wav.replace(".wav", "_g.mp3")
    try:
        from gtts import gTTS
        gTTS(text=text, lang=lang, slow=(lang=="de")).save(tmp)
        if not os.path.exists(tmp) or os.path.getsize(tmp) < 1000: return False
        run_ff([ffmpeg,"-y","-i",tmp,"-ar","44100","-ac","2","-sample_fmt","s16",out_wav],
               raise_on_error=False)
        return os.path.exists(out_wav) and os.path.getsize(out_wav) > 4096
    except Exception as e:
        print(f"        gTTS: {e}"); return False
    finally:
        try:
            if os.path.exists(tmp): os.remove(tmp)
        except: pass

def normalize_wav(ffmpeg, in_wav, out_wav):
    try:
        run_ff([ffmpeg,"-y","-i",in_wav,
                "-af","loudnorm=I=-14:TP=-2:LRA=11",
                "-ar","44100","-ac","2","-sample_fmt","s16",out_wav])
        if os.path.exists(out_wav) and os.path.getsize(out_wav) > 4096:
            return out_wav
    except: pass
    return in_wav

def generate_voice_wav(text, lang, out_wav, edge_voice=None):
    """Generate voice: pyttsx3 → Edge TTS → gTTS, then normalize to 44100Hz."""
    ffmpeg  = get_ffmpeg()
    tmp_raw = out_wav.replace(".wav", "_raw.wav")
    tmp_nrm = out_wav.replace(".wav", "_nrm.wav")
    ok = False

    if lang == "en":
        if tts_pyttsx3_wav(text, tmp_raw):
            ok = True; print(f"        [pyttsx3 ✓] {os.path.basename(out_wav)}")

    if not ok and edge_voice:
        if tts_edge_wav(text, edge_voice, tmp_raw):
            ok = True; print(f"        [Edge TTS ✓] {os.path.basename(out_wav)}")

    if not ok:
        if tts_gtts_wav(text, lang, tmp_raw):
            ok = True; print(f"        [gTTS ✓] {os.path.basename(out_wav)}")

    if not ok or not os.path.exists(tmp_raw):
        print(f"        [silence] {os.path.basename(out_wav)}")
        run_ff([ffmpeg,"-y","-f","lavfi","-i","anullsrc=r=44100:cl=stereo",
                "-t","2","-sample_fmt","s16",tmp_raw])

    # SYNC FIX: always normalize AND resample to exactly 44100Hz s16
    normalized = normalize_wav(ffmpeg, tmp_raw, tmp_nrm)
    resampled  = out_wav.replace(".wav","_rs.wav")
    final_src  = resample_wav(ffmpeg, normalized, resampled)
    shutil.copy2(final_src, out_wav)

    for f in [tmp_raw, tmp_nrm, resampled]:
        try:
            if f and f != out_wav and os.path.exists(f): os.remove(f)
        except: pass
    return out_wav

def ensure_tagline(script_dir, ffmpeg):
    path = os.path.join(script_dir, TAGLINE_FILE)
    if os.path.exists(path) and os.path.getsize(path) > 4096:
        # SYNC FIX: re-resample tagline to match other audio
        rs = path.replace(".wav","_rs.wav")
        resample_wav(ffmpeg, path, rs)
        if os.path.exists(rs) and os.path.getsize(rs) > 4096:
            shutil.copy2(rs, path)
            try: os.remove(rs)
            except: pass
        print("      Tagline audio ✓"); return path
    print("      Generating tagline audio (one-time)...")
    generate_voice_wav(TAGLINE_TEXT, "en", path, ENGLISH_VOICE_EDGE)
    return path

def generate_audio(data, work_dir, ffmpeg):
    print("[3/5] Generating voice audio...")
    jobs = [
        ("intro",      data["intro_speech"],            "en", ENGLISH_VOICE_EDGE),
        ("word_de",    data["german_word"],              "de", GERMAN_VOICE_EDGE),
        ("word_en",    data["word_speech_en"],           "en", ENGLISH_VOICE_EDGE),
        ("example_de", data["example_sentence_german"], "de", GERMAN_VOICE_EDGE),
        ("example_en", data["example_speech_en"],       "en", ENGLISH_VOICE_EDGE),
        ("outro",      data["outro_speech"],             "en", ENGLISH_VOICE_EDGE),
        # NEW: dynamic comment prompt audio
        ("comment",    data["comment_prompt_speech"],   "en", ENGLISH_VOICE_EDGE),
    ]
    audio = {}
    for key, text, lang, voice in jobs:
        path = os.path.join(work_dir, f"audio_{key}.wav")
        generate_voice_wav(text, lang, path, edge_voice=voice)
        audio[key] = path
        time.sleep(0.3)
    return audio

# ==================================================
#   FONTS
