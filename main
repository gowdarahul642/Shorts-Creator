    # Bottom button: "Comment below"
    # Dynamic question based on example sentence word
    CT7    = 480
    inner7 = CT7 + CARD_PAD_Y
    CBTN7  = inner7 + 320

    d7   = get_dur(ffmpeg,audio["comment"])
    bg7  = make_bg(ffmpeg,valid[0:3],d7+0.5,work_dir,"bg7")
    b7dk = dark_overlay(ffmpeg,bg7,work_dir,"bg7",0.62)
    v7a  = overlay_card(ffmpeg,b7dk,  c_comment,    20, CT7,  work_dir,"s7_card")
    v7b  = overlay_card(ffmpeg,v7a,   c_comment_btn,190,CBTN7,work_dir,"s7_btn")

    s7 = add_text_and_audio(ffmpeg,v7b,audio["comment"],
        # Challenge header
        f"drawtext=text='Your Challenge':fontfile='{fb}':fontsize=36:"
        f"fontcolor=#{PURP}:x=(w-tw)/2:y={inner7}:alpha='{fade()}',"
        # Decorative divider with purple accent
        f"drawbox=x=40:y={inner7+46}:w={VW-80}:h=3:color=#{PURP}@0.5:t=fill,"
        # Dynamic question — unique per video
        f"drawtext=text='{comment_display}':fontfile='{fb}':fontsize=38:"
        f"fontcolor=#ffffff:x=(w-tw)/2:y={inner7+62}:"
        f"shadowcolor=#{PURP}:shadowx=0:shadowy=3:alpha='{fade(0.15)}',"
        # Hint line
        f"drawtext=text='Hint - check the example sentence above':fontfile='{fr}':fontsize=22:"
        f"fontcolor=#888899:x=(w-tw)/2:y={inner7+150}:alpha='{fade(0.4)}',"
        # Engagement line
        f"drawtext=text='Answer in the comments':fontfile='{fm}':fontsize=26:"
        f"fontcolor=#{TEAL}:x=(w-tw)/2:y={inner7+196}:alpha='{fade(0.5)}',"
        # Reward line
        f"drawtext=text='We reveal it in the next video':fontfile='{fr}':fontsize=22:"
        f"fontcolor=#666688:x=(w-tw)/2:y={inner7+240}:alpha='{fade(0.6)}',"
        # CTA button text
        f"drawtext=text='COMMENT BELOW':fontfile='{fb}':fontsize=28:"
        f"fontcolor=#ffffff:x=(w-tw)/2:y={CBTN7+28}:alpha='{fade(0.4)}'",
        work_dir,"s7")
    segs.append(s7); print("      Seg 7 ✓ — comment prompt")

    # ── JOIN ALL 7 SEGMENTS ─────────────────────────────────
    joined = join_segments(ffmpeg, segs, work_dir, "main")
    print("      All 7 segments joined ✓")

    # ── LOGO + MUSIC ────────────────────────────────────────
    script_dir = os.path.dirname(os.path.abspath(__file__))
    lp = logo_path  if os.path.isabs(logo_path)  else os.path.join(script_dir,logo_path)
    mp = music_path if os.path.isabs(music_path) else os.path.join(script_dir,music_path)
    has_logo  = os.path.exists(lp)
    has_music = os.path.exists(mp)
    print(f"      Logo: {'✓' if has_logo else '✗'} | Music: {'✓' if has_music else '✗'}")

    if has_logo and has_music:
        run_ff([ffmpeg,"-y","-i",joined,"-i",mp,"-i",lp,
                "-filter_complex",
                f"[2:v]scale=90:-1[logo];[0:v][logo]overlay=W-w-16:16:format=auto[vout];"
                f"[0:a][1:a]amix=inputs=2:weights={VOICE_WEIGHT} {MUSIC_WEIGHT}:"
                f"duration=first:normalize=0[aout]",
                "-map","[vout]","-map","[aout]",
                "-c:v","libx264","-crf","20","-preset","fast",
                "-c:a","aac","-ar","44100","-b:a","192k",
                "-movflags","+faststart",output])
    elif has_logo:
        run_ff([ffmpeg,"-y","-i",joined,"-i",lp,
                "-filter_complex",
                "[1:v]scale=90:-1[logo];[0:v][logo]overlay=W-w-16:16:format=auto[vout]",
                "-map","[vout]","-map","0:a",
                "-c:v","libx264","-crf","20","-preset","fast",
                "-movflags","+faststart",output])
    elif has_music:
        run_ff([ffmpeg,"-y","-i",joined,"-i",mp,
                "-filter_complex",
                f"[0:a][1:a]amix=inputs=2:weights={VOICE_WEIGHT} {MUSIC_WEIGHT}:"
                f"duration=first:normalize=0[aout]",
                "-map","0:v","-map","[aout]",
                "-c:v","libx264","-crf","20","-preset","fast",
                "-c:a","aac","-ar","44100","-b:a","192k",
                "-movflags","+faststart",output])
    else:
        run_ff([ffmpeg,"-y","-i",joined,
                "-c:v","libx264","-crf","20","-preset","fast",
                "-movflags","+faststart",output])

    print(f"      Final video: {output}")
    return output

# ==================================================
#   YOUTUBE UPLOAD
# ==================================================

def get_youtube_service():
    from googleapiclient.discovery import build
    from google_auth_oauthlib.flow import InstalledAppFlow
    from google.auth.transport.requests import Request
    creds=None
    if os.path.exists(YOUTUBE_CREDS):
        with open(YOUTUBE_CREDS,"rb") as f: creds=pickle.load(f)
    if not creds or not creds.valid:
        if creds and creds.expired and creds.refresh_token:
            creds.refresh(Request())
        else:
            flow=InstalledAppFlow.from_client_secrets_file(
                YOUTUBE_SECRETS,
                scopes=["https://www.googleapis.com/auth/youtube.upload"])
            creds=flow.run_local_server(port=0)
        with open(YOUTUBE_CREDS,"wb") as f: pickle.dump(creds,f)
    return build("youtube","v3",credentials=creds)

def upload_to_youtube(data, video_path):
    from googleapiclient.http import MediaFileUpload
    print("[5/5] Uploading to YouTube...")
    publish_at=(datetime.utcnow()+timedelta(hours=SCHEDULE_HOURS_AHEAD)
               ).strftime("%Y-%m-%dT%H:%M:%S.000Z")
    youtube=get_youtube_service()

    # Add comment prompt to description to drive engagement
    comment_q = data.get("comment_prompt_display","")
    desc = data["youtube_description"]
    if comment_q:
        desc += f"\n\nChallenge: {comment_q}\nWrite your answer in the comments!"

    body={
        "snippet":{"title":data["youtube_title"],"description":desc,
                   "tags":data["tags"],"categoryId":"27","defaultLanguage":"en"},
        "status":{"privacyStatus":"private","publishAt":publish_at,
                  "selfDeclaredMadeForKids":False,"madeForKids":False}
    }
    media=MediaFileUpload(video_path,mimetype="video/mp4",resumable=True,
                          chunksize=1024*1024*5)
    req=youtube.videos().insert(part="snippet,status",body=body,media_body=media)
    resp=None
    while resp is None:
        st,resp=req.next_chunk()
        if st: print(f"      Upload: {int(st.progress()*100)}%")
    vid=resp["id"]
    print(f"      ✓ https://youtube.com/watch?v={vid}")
    print(f"      Scheduled: {publish_at} UTC")
    return vid

